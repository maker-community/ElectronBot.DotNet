<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Verdure.Braincase.Settings.Views.AboutAppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Verdure.Braincase.Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel>
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="Call" Command="{x:Bind ViewModel.FeedbackBtnCommand}">
                            <Button.Content>
                                <StackPanel>
                                    <FontIcon
                                        FontFamily="/Assets/Font/Segoe Fluent Icons.ttf#Segoe Fluent Icons"
                                        FontSize="80"
                                        Foreground="Green"
                                        Glyph="&#xE1A8;" />
                                    <TextBlock
                                        x:Uid="FeedBackText"
                                        HorizontalAlignment="Center"
                                        FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                        FontSize="24"
                                        Foreground="Red" />
                                </StackPanel>

                            </Button.Content>
                        </Button>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                            <TextBlock
                                Margin="8"
                                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                Foreground="Red"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="如果你觉得本软件对你有帮助，你可以邮件反馈或者打赏作者。" />
                            <Button
                                x:Uid="DaShang"
                                Margin="8"
                                VerticalAlignment="Bottom"
                                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                FontSize="32"
                                Foreground="Red">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Margin="4" Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBlock
                                                    x:Uid="alipay"
                                                    Margin="4"
                                                    HorizontalAlignment="Center"
                                                    FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑" />
                                                <Image
                                                    Width="200"
                                                    Height="200"
                                                    Source="ms-appx:///Assets/alipay.JPG" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock
                                                    x:Uid="wechat"
                                                    Margin="4"
                                                    HorizontalAlignment="Center"
                                                    FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑" />
                                                <Image
                                                    Width="200"
                                                    Height="200"
                                                    Source="ms-appx:///Assets/wechat.JPG" />
                                            </StackPanel>

                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                </StackPanel>

                <HyperlinkButton
                    x:Uid="DownloadDebugger"
                    Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                    FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                    FontSize="24"
                    FontWeight="Bold"
                    NavigateUri="https://www.microsoft.com/store/productId/9P9XF62G5R9S" />

                <StackPanel Margin="8">
                    <TextBlock
                        x:Name="hlOpenPrivacySettings"
                        x:Uid="hlOpenPrivacySettings"
                        FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                        FontSize="20"
                        TextWrapping="WrapWholeWords" />
                    <HyperlinkButton x:Uid="PrivacyHyperLink" Click="OpenPrivacySettings_Click" />
                </StackPanel>

                <TextBlock x:Uid="Settings_About" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />

                    <TextBlock
                        x:Uid="Settings_AboutDescription"
                        MaxWidth="500"
                        Margin="{StaticResource XSmallTopMargin}"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <HyperlinkButton x:Uid="SettingsPage_PrivacyTermsLink" Margin="{StaticResource SettingsPageHyperlinkButtonMargin}" />
                </StackPanel>

                <TextBlock x:Uid="Settings_Thank" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}">
                    <TextBlock x:Uid="Reference" Style="{ThemeResource BodyTextBlockStyle}" />

                    <HyperlinkButton
                        x:Uid="VerdureBilibili"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                        NavigateUri="https://space.bilibili.com/25228512" />

                    <HyperlinkButton
                        x:Uid="ElectronSourceCode"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                        NavigateUri="https://github.com/peng-zhihui/ElectronBot" />

                    <HyperlinkButton
                        x:Uid="AppLogoAuthor"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                        NavigateUri="https://space.bilibili.com/38053181" />
                    <HyperlinkButton
                        x:Uid="ClockAuthor"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                        NavigateUri="https://github.com/DinoChan" />
                    <HyperlinkButton
                        x:Uid="ElectronBotInfo"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                        NavigateUri="https://github.com/maker-community/Verdure.Braincase" />
                    <HyperlinkButton
                        x:Uid="ElectronBotCode"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}"
                        NavigateUri="https://github.com/maker-community/ElectronBot.DotNet" />
                </StackPanel>

                <TextBlock x:Uid="Settings_Update" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}">
                    <TextBlock
                        x:Uid="Settings_AboutUpdate"
                        MaxWidth="500"
                        Margin="0,8,0,24"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
