<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Verdure.Braincase.Settings.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Verdure.Braincase.Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid
            Padding="20,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="20">
            <SelectorBar
                x:Name="SettingSectionSelector"
                Grid.Column="1"
                VerticalAlignment="Center"
                SelectionChanged="OnSettingSectionChanged">
                <SelectorBarItem
                    x:Name="BasicSettings"
                    x:Uid="BasicSettings"
                    IsSelected="True" />
                <SelectorBarItem x:Name="DialogueSettings" x:Uid="DialogueSettings" />
                <SelectorBarItem x:Name="VoiceSettings" x:Uid="VoiceSettings" />
                <SelectorBarItem x:Name="DrawingSettings" x:Uid="DrawingSettings" />
                <SelectorBarItem x:Name="AboutApp" x:Uid="AboutApp" />
            </SelectorBar>
        </Grid>
        <Frame x:Name="SectionFrame" Grid.Row="1" />
    </Grid>
</Page>
