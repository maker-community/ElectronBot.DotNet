{
  "name": "custom_generate_image",
  "description": "如果用户想生成图片可以调用此方法进行图片生成。",
  "parameters": {
    "type": "object",
    "properties": {
      "image_name": {
        "type": "string",
        "description": "根据用户描述给图片起个名称。"
      },
      "image_description": {
        "type": "string",
        "description": "用户进行的图片描述。"
      },
      "show_to_screen": {
        "type": "boolean",
        "description": "是否展示到屏幕,用户不明确要求不显示。"
      }
    },
    "required": [ "image_name", "image_description", "show_to_screen" ]
  }
}