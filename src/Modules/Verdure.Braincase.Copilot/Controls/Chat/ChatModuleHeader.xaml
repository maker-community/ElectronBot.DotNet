<?xml version="1.0" encoding="utf-8" ?>
<local:ChatModuleControl
    x:Class="Verdure.Braincase.Copilot.Controls.Chat.ChatModuleHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Verdure.Braincase.Copilot.Controls.Chat"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Column="0"
            Margin="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="24"
            Text="{x:Bind ViewModel.SelectedConversation.Title, Mode=OneWay}" />
        <Button Grid.Column="1" HorizontalAlignment="Right">
            <FontIcon FontFamily="/Assets/Font/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE712;" />
        </Button>
    </Grid>
</local:ChatModuleControl>
