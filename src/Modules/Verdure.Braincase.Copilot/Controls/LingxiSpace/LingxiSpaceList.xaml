<?xml version="1.0" encoding="utf-8" ?>
<local:LingxiSpaceControl
    x:Class="Verdure.Braincase.Copilot.Controls.LingxiSpace.LingxiSpaceList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Verdure.Braincase.Copilot.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core"
    xmlns:local="using:Verdure.Braincase.Copilot.Controls.LingxiSpace"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Verdure.Braincase.Copilot.ViewModels"
    xmlns:models="using:BotSharp.Abstraction.Conversations.Models"
    xmlns:myconverters="using:Verdure.Braincase.WinUI.Common.Converters"
    mc:Ignorable="d">
    <local:LingxiSpaceControl.Resources>
        <DataTemplate x:Key="TextTemplate" x:DataType="model:LingxiSpaceItemViewModel">
            <StackPanel Margin="12">
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                    FontSize="24"
                    LineHeight="12"
                    Text="{x:Bind Name}" />
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                    FontSize="20"
                    LineHeight="12"
                    MaxLines="3"
                    Text="{x:Bind Desc}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                    Text="{x:Bind CreatedTime, Converter={StaticResource UtcToLocalTimeConverter}, ConverterParameter='yyyy-MM-dd HH:mm:ss'}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ImageTemplate" x:DataType="model:LingxiSpaceItemViewModel">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    x:Name="ImageBorder"
                    MaxHeight="400"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="{ThemeResource SystemAccentColor}"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Image Source="{x:Bind ImageData, Converter={StaticResource Base64ToBitmapImageConverter}}">
                        <Image.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="ViewInfo" x:Uid="SetClockViewImageMenu">
                                    <i:Interaction.Behaviors>
                                        <ic:EventTriggerBehavior EventName="Click">
                                            <ic:InvokeCommandAction Command="{x:Bind LingxiItemClickCommand}" CommandParameter="{x:Bind}" />
                                        </ic:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Image.ContextFlyout>
                    </Image>
                </Border>
                <Border />
                <StackPanel Grid.Row="1">
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                        FontSize="24"
                        FontWeight="SemiBold"
                        LineHeight="12"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                        FontSize="20"
                        FontWeight="Normal"
                        LineHeight="12"
                        MaxLines="3"
                        Text="{x:Bind Desc}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                        Text="{x:Bind CreatedTime, Converter={StaticResource UtcToLocalTimeConverter}, ConverterParameter='yyyy-MM-dd HH:mm:ss'}" />
                </StackPanel>
            </Grid>

        </DataTemplate>
        <local:LingxiSpaceItemTemplateSelector
            x:Key="LingxiSpaceItemTemplateSelector"
            ImageTemplate="{StaticResource ImageTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />
        <!--  其他资源  -->
        <myconverters:Base64ToBitmapImageConverter x:Key="Base64ToBitmapImageConverter" />
        <myconverters:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter" />
    </local:LingxiSpaceControl.Resources>
    <Grid>
        <controls:EmptyHolder
            x:Uid="HomeLingxiHeader"
            Emoji="&#x1F3A8;"
            Style="{StaticResource BasicEmptyHolderStyle}"
            Visibility="{x:Bind ViewModel.IsLingxiEmpty, Mode=OneWay}" />
        <ScrollViewer
            x:Name="MessageViewer"
            Style="{StaticResource PageScrollViewerStyle}"
            UseLayoutRounding="False">
            <Grid Margin="0,12,0,0">
                <StackPanel>
                    <ItemsControl
                        x:Name="LinxiList"
                        Margin="0,0,0,20"
                        IsTapEnabled="True"
                        ItemTemplateSelector="{StaticResource LingxiSpaceItemTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.LingxiSpaceList, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel
                        Margin="0,0,0,12"
                        Padding="20,12"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ErrorBlock"
                            MaxWidth="240"
                            HorizontalAlignment="Center"
                            MaxLines="3"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="ErrorText"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:LingxiSpaceControl>
