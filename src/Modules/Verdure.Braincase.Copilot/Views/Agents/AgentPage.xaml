<Page
    x:Class="Verdure.Braincase.Copilot.Views.AgentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BotSharp.Abstraction.Agents.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Key="AgentTemplate" x:DataType="models:Agent">
            <Grid
                Height="200"
                Margin="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Height="80"
                            Margin="8">
                            <TextBlock
                                Margin="4"
                                HorizontalAlignment="Left"
                                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                FontSize="20"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                Margin="4"
                                HorizontalAlignment="Left"
                                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                FontSize="16"
                                Text="{x:Bind Description}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Margin="8"
                            Orientation="Horizontal">
                            <!--<TextBlock
                                Margin="4"
                                HorizontalAlignment="Left"
                                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                FontSize="20"
                                Text="{x:Bind LlmConfig.Provider}" />-->
                            <TextBlock
                                Margin="4"
                                HorizontalAlignment="Left"
                                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                                FontSize="16"
                                Text="{x:Bind LlmConfig.Model}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Line
                                Margin="8"
                                Stroke="{ThemeResource SystemAccentColor}"
                                StrokeThickness="1"
                                X1="0"
                                X2="400"
                                Y1="0"
                                Y2="0" />
                            <StackPanel Orientation="Horizontal">
                                <!--<CommandBar
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    IsOpen="False">
                                    <AppBarButton Icon="Add" Label="Add" />
                                    <AppBarButton Icon="Edit" Label="Edit" />
                                    <AppBarButton Icon="Share" Label="Share" />
                                </CommandBar>-->
                                <TextBlock
                                    Margin="12"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Type}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock
                x:Uid="ResetAgentTip"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                FontSize="16"
                Foreground="Red"
                TextWrapping="WrapWholeWords" />
            <AppBarButton
                x:Uid="ResetAgentBtn"
                Margin="8"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.ResetAgentCommand}"
                FontFamily="/Assets/Font/SmileySans-Oblique.ttf#得意黑"
                Foreground="{ThemeResource SystemAccentColor}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="/Assets/Font/Segoe Fluent Icons.ttf#Segoe Fluent Icons"
                        FontWeight="Bold"
                        Glyph="&#xEBC4;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </StackPanel>
        <GridView
            x:Name="AdaptiveGridViewControl"
            Grid.Row="1"
            CornerRadius="8"
            IsEnabled="True"
            IsItemClickEnabled="True"
            ItemTemplate="{StaticResource AgentTemplate}"
            ItemsSource="{x:Bind ViewModel.Agents, Mode=OneWay}"
            SelectionMode="Single">
            <!--<GridView.ContextFlyout>
          <MenuFlyout>
              <MenuFlyoutItem x:Name="ViewInfo" x:Uid="ViewEmojisInfo">
                  <i:Interaction.Behaviors>
                      <ic:EventTriggerBehavior EventName="Click">
                          <ic:InvokeCommandAction Command="{x:Bind ViewModel.EmojisInfoCommand}" CommandParameter="{x:Bind AdaptiveGridViewControl.SelectedItem, Mode=TwoWay}" />
                      </ic:EventTriggerBehavior>
                  </i:Interaction.Behaviors>
              </MenuFlyoutItem>
          </MenuFlyout>
      </GridView.ContextFlyout>-->
        </GridView>
    </Grid>
</Page>
