<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Verdure.Braincase.EbScreen.Views.MiniModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core"
    xmlns:local="using:Verdure.Braincase.EbScreen.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Loaded">
            <ic:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </ic:EventTriggerBehavior>
        <ic:EventTriggerBehavior EventName="UnLoaded">
            <ic:InvokeCommandAction Command="{x:Bind ViewModel.UnLoadedCommand}" />
        </ic:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Row="1"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel
                Margin="4"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <RadioButtons
                    x:Name="ModeRadioBtn"
                    x:Uid="ModeRadioBtn"
                    MaxColumns="2"
                    SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <ic:EventTriggerBehavior EventName="SelectionChanged">
                            <ic:InvokeCommandAction Command="{x:Bind ViewModel.RadioButtonSelectionChangedCommand}" CommandParameter="{x:Bind ModeRadioBtn.SelectedItem, Mode=TwoWay}" />
                        </ic:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    <RadioButton x:Name="NaturalMode" x:Uid="NaturalModeRb" />
                    <RadioButton x:Name="ClockMode" x:Uid="ClockModeRb" />
                    <RadioButton x:Name="NeedleMode" x:Uid="NeedleModeRb" />
                    <RadioButton x:Name="DisableMode" x:Uid="DisableModeRb" />
                </RadioButtons>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    x:Uid="ChangeClockViewCB"
                    Width="100"
                    Margin="4"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DataValue"
                    ItemsSource="{x:Bind ViewModel.ClockComboxModels}"
                    SelectedItem="{x:Bind ViewModel.ClockComBoxSelect, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <ic:EventTriggerBehavior EventName="SelectionChanged">
                            <ic:InvokeCommandAction Command="{x:Bind ViewModel.ClockChangedCommand}" />
                        </ic:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                </ComboBox>
            </StackPanel>
            <!--<Button
                Width="80"
                Height="80"
                Margin="24"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="2"
                CornerRadius="40"
                Foreground="{ThemeResource SystemAccentColor}">
                <FontIcon
                    FontFamily="/Assets/Font/Segoe Fluent Icons.ttf#Segoe Fluent Icons"
                    FontSize="40"
                    Glyph="&#xE720;" />
            </Button>-->
        </StackPanel>
        <Border
            x:Name="BorderGrid"
            Grid.Row="1"
            Grid.Column="1"
            Margin="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="2"
            Child="{x:Bind ViewModel.Element, Mode=OneWay}"
            CornerRadius="24" />
    </Grid>
</Page>
