<UserControl
    x:Class="Verdure.Braincase.ClockViews.Bubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Verdure.Braincase.ClockViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="LayoutRoot"
        Width="160"
        Height="160"
        Background="#db0b09"
        IsHitTestVisible="False">
        <Image
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="/Assets/SmallTile.scale-100.png" />
        <Rectangle
            x:Name="Rectangle1"
            Width="100"
            Height="100"
            Margin="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.9"
            RadiusX="27"
            RadiusY="24"
            Stroke="White"
            StrokeThickness="3" />
        <Rectangle
            x:Name="Rectangle2"
            Width="100"
            Height="100"
            Margin="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.8"
            RadiusX="27"
            RadiusY="24"
            Stroke="White" />
    </Grid>
</UserControl>
