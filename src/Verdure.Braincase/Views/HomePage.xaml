<Page
    x:Class="Verdure.Braincase.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:Verdure.Braincase.Copilot.Controls.Chat"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:controlLocal="using:Verdure.Braincase.Controls"
    xmlns:controls="using:Verdure.Braincase.Copilot.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core"
    xmlns:lingxiSpace="using:Verdure.Braincase.Copilot.Controls.LingxiSpace"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Verdure.Braincase.WinUI.Common.Models"
    xmlns:models="using:BotSharp.Abstraction.Conversations.Models"
    xmlns:myconverters="using:Verdure.Braincase.WinUI.Common.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="ContactListViewTemplate" x:DataType="models:Conversation">
            <Grid Padding="12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    MaxLines="1"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind CreatedTime, Converter={StaticResource UtcToLocalTimeConverter}, ConverterParameter='MM-dd'}" />
            </Grid>
        </DataTemplate>
        <myconverters:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter" />

    </Page.Resources>

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Top">
            <StackPanel
                Margin="4"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <RadioButtons
                    x:Uid="ModeRadioBtn"
                    MaxColumns="2"
                    SelectedIndex="0"
                    SelectionChanged="{x:Bind ViewModel.RadioButtons_SelectionChanged}">
                    <RadioButton x:Uid="DisableModeRb" />
                    <RadioButton x:Uid="ControlMode" />
                    <RadioButton x:Uid="ClockModeRb" />
                    <RadioButton x:Uid="NeedleModeRb" />
                </RadioButtons>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border
                        x:Name="BorderGrid"
                        Width="200"
                        Height="200"
                        Margin="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="2"
                        Child="{x:Bind ViewModel.Element, Mode=OneWay}"
                        CornerRadius="8" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="Reset"
                    x:Uid="ResetBtn"
                    Width="100"
                    Margin="8"
                    Command="{x:Bind ViewModel.ResetCommand}" />
                <Button
                    x:Name="RebootElectron"
                    x:Uid="RebootElectron"
                    Width="100"
                    Margin="8"
                    Command="{x:Bind ViewModel.RebootElectronCommand}" />

            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="ElectronEmulation"
                    x:Uid="ElectronEmulation"
                    Width="100"
                    Margin="8"
                    Command="{x:Bind ViewModel.ElectronEmulationCommand}" />
                <ComboBox
                    x:Uid="ChangeClockViewCB"
                    Width="100"
                    Margin="8"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DataValue"
                    ItemsSource="{x:Bind ViewModel.ClockComboxModels}"
                    SelectedItem="{x:Bind ViewModel.ClockComBoxSelect, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <ic:EventTriggerBehavior EventName="SelectionChanged">
                            <ic:InvokeCommandAction Command="{x:Bind ViewModel.ClockChangedCommand}" />
                        </ic:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.RowSpan="2" Grid.Column="1">
            <chat:ChatModulePanel
                Width="360"
                HorizontalAlignment="Left"
                ViewModel="{x:Bind ChatViewModel, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.RowSpan="2" Grid.Column="2">
            <lingxiSpace:LingxiSpacePanel ViewModel="{x:Bind LingxiSpaceViewModel, Mode=OneWay}" />
        </StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters />
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters />
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
